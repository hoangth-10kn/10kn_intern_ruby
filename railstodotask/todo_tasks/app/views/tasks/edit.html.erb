<% content_for :title, "Editing task" %>

<h1 class="mb-4">Editing task</h1>

<div class="card shadow-sm">
  <div class="card-body">
    <%= render "form", task: @task %>

    <hr class="my-4">

    <div class="d-flex gap-2">
      <%= link_to "Show this task", @task, class: "btn btn-outline-primary" %>
      <%= link_to "Back to tasks", tasks_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
